# Used by wrangler when you deploy from a shell or CI. Copy to .env and keep it private.
# Scope the token to Workers and R2 on one account. See "Invite a developer" in the README.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ADMIN_KEY is not set here. Store it as a Worker secret: wrangler secret put ADMIN_KEY
# Local development reads it from .dev.vars, for example: ADMIN_KEY=local-dev-only

# Only test/live.sh reads these.
RELAY_URL=
RELAY_ADMIN_KEY=
